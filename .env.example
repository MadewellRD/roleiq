# RoleIQ uses exactly ONE text provider per run: whichever key is present.
# If both are set, ANTHROPIC_API_KEY wins.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional per-provider model override.
# Defaults: claude-sonnet-5 (Anthropic), gpt-5.6-luna (OpenAI)
# RoleIQ_MODEL_ANTHROPIC=claude-sonnet-5
# RoleIQ_MODEL_OPENAI=gpt-5.6-luna

# Voice answers are transcribed by OpenAI regardless of the active text
# provider, because Anthropic exposes no speech-to-text endpoint. The voice
# tab hides itself when OPENAI_API_KEY is absent.
# RoleIQ_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Public company/technical research via server-side web search. Both providers
# support it; leave off unless you want live research.
# RoleIQ_ROLE_CONTEXT_ENABLED=1

# Encryption at rest for stored resume/JD/analysis/context/history text (Fernet key).
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, RoleIQ auto-generates a throwaway key each run and WARNS loudly --
# previously saved encrypted data becomes unreadable after restart. Set this to
# persist data across runs.
# RoleIQ_DB_KEY=

# Byte-size and page caps for uploaded JD/resume files (defense in depth; see
# also .streamlit/config.toml's maxUploadSize, which must be raised too if you
# raise this).
# RoleIQ_MAX_UPLOAD_MB=15
# RoleIQ_MAX_PDF_PAGES=200
